{
  "build": {
    "env": {
      "UV_LINK_MODE": "copy"
    }
  },
  "env": {
    "UV_LINK_MODE": "copy"
  },
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(chat|health|docs|openapi.json|documents|admin)(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

